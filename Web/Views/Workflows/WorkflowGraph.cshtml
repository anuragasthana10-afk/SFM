@using System.Collections.Generic
@using System.Linq
@using CRM.Models.Workflows
@using CRM.Classes.Helpers.WorkflowHelpers
@model CRM.Models.Workflows.WorkflowStepsMap

@{
    WorkflowGraphLayout layout = null;
    Dictionary<short, WorkflowGraphNode> nodesById = new Dictionary<short, WorkflowGraphNode>();

    if (Model != null)
    {
        layout = WorkflowGraphLayoutBuilder.Build(Model);
        nodesById = layout.Nodes.ToDictionary(x => x.StepId, x => x);
    }
}

<div style="overflow:auto; border:1px solid #d9d9d9; border-radius:8px; padding:8px; background:#fafafa;">
    @if (layout == null)
    {
        <div>No workflow graph available.</div>
    }
    else
    {
        <svg width="@layout.Width" height="@layout.Height" viewBox="0 0 @layout.Width @layout.Height">
            <defs>
                <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                    <polygon points="0 0, 10 3.5, 0 7" fill="#64748b" />
                </marker>
            </defs>

            @foreach (var edge in layout.Edges)
            {
                var from = nodesById[edge.FromStepId];
                var to = nodesById[edge.ToStepId];
                var x1 = from.X + (from.Width / 2);
                var y1 = from.Y + from.Height;
                var x2 = to.X + (to.Width / 2);
                var y2 = to.Y;

                <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="#64748b" stroke-width="2" marker-end="url(#arrowhead)" />
            }

            @foreach (var node in layout.Nodes)
            {
                <rect x="@node.X" y="@node.Y" width="@node.Width" height="@node.Height" rx="8" ry="8" fill="#ffffff" stroke="#1e40af" stroke-width="1.8" />
                @Html.Raw("<text x=\"" + (node.X + 12) + "\" y=\"" + (node.Y + 30) + "\" font-family=\"Segoe UI, Arial, sans-serif\" font-size=\"14\" fill=\"#0f172a\">" + Html.Encode(node.Name) + "</text>")
                @Html.Raw("<text x=\"" + (node.X + 12) + "\" y=\"" + (node.Y + 54) + "\" font-family=\"Consolas, monospace\" font-size=\"12\" fill=\"#475569\">ID: " + node.StepId + "</text>")
            }
        </svg>
    }
</div>
