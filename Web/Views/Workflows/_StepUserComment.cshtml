@model string

@{
    var _comment = Model;
}

@if (!string.IsNullOrWhiteSpace(_comment))
{
    string[] words = _comment
        .Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

    var shortText = (words.Length <= 2)
        ? _comment
        : string.Join(" ", words.Take(2)) + "...";

    <div class="wf-comment-line">
        <span class="wf-comment-label">Comment:</span>
        <span class="wf-comment-text">@shortText</span>

        @* show icon only if > 2 words *@
        @if (words.Length > 2)
        {
            <a href="javascript:void(0);"
               class="wf-comment-more"
               title="View full comment"
               data-comment="@Html.AttributeEncode(_comment)">
                <i class="la la-comment"></i>
            </a>
        }
    </div>
}
