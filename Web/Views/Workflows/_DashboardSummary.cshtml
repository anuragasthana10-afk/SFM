<script>
    function openWorkflowStatusPopup(workflowHeaderID) {
        // show modal immediately with loader
        $('#workflowStatusModalBody').html('<div class="text-muted">Loading workflow status...</div>');
        $('#workflowStatusModal').modal('show');

        // 1) Call WebAPI to get JSON status
        $.ajax({
            url: "/api/Workflow/GetWorkflowInstanceStatus",
            type: "GET",
            data: { workflowTxnHeaderID: workflowHeaderID }
        })
            .done(function (apiRes) {
                if (!apiRes || apiRes.ResponseCode !== "1") {
                    $('#workflowStatusModalBody').html(
                        '<div class="text-danger">' + (apiRes && apiRes.ResponseMessage ? apiRes.ResponseMessage : 'Failed to load workflow status.') + '</div>'
                    );
                    return;
                }

                // AdditionalData1 is JSON string in your API
                var workflowDataObj = null;
                try {
                    workflowDataObj = apiRes.AdditionalData1 ? JSON.parse(apiRes.AdditionalData1) : null;
                } catch (e) {
                    workflowDataObj = null;
                }

                //POST JSON to MVC action that renders the partial
                $.ajax({
                    url: "/Workflows/RenderWorkflowView",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    dataType: "html",
                    data: JSON.stringify({
                        workflowHeaderID: workflowHeaderID,
                        workflowData: workflowDataObj // send as object (your action supports object)
                    })
                })
                    .done(function (html) {
                        $('#workflowStatusModalBody').html('<div id="workflow_' + workflowHeaderID + '">' + html + '</div>');
                        updateWorkflowHeaders(workflowHeaderID, workflowDataObj);

                    })
                    .fail(function (xhr) {
                        $('#workflowStatusModalBody').html(
                            '<div class="text-danger">Failed to render workflow view. Check console/network.</div>'
                        );
                        console.log("RenderWorkflowView failed:", xhr);
                    });
            })
            .fail(function (xhr) {
                $('#workflowStatusModalBody').html(
                    '<div class="text-danger">Failed to load workflow status from API. Check console/network.</div>'
                );
                console.log("GetWorkflowInstanceStatus failed:", xhr);
            });
    }

    function updateWorkflowHeaders(id, data) {

        $('#workflowHeader').text(data.AdditionalWorkflowDescription);
        $('#workflow_' + id).find('#wfCurrentStep').text(data.CurrentStep?.Name || '');
    }

    function extractCurrentStep(workflowData) {
        if (!workflowData || !workflowData.WorkflowStepStatuses) {
            return null;
        }

        const steps = workflowData.WorkflowStepStatuses;

        // Prefer explicit current step
        let step = steps.find(s => s.IsCurrentStep === true);

        // Fallback: last step in array
        if (!step && steps.length) {
            step = steps[steps.length - 1];
        }

        return step || null;
    }

    function buildWorkflowStatusValues(workflowData) {
        const step = extractCurrentStep(workflowData);
        if (!step) return null;

        return {
            waitingOn: step.StepName || '',
            assignedTo: step.AssignedUser
                ? step.AssignedUser
                : (step.AssignedRole || 'Unassigned'),
            extDays: step.EstimatedDaysRemaining != null
                ? step.EstimatedDaysRemaining
                : ''
        };
    }
    function updateWorkflowListDom(headerId, workflowDataObj) {
        const values = buildWorkflowStatusValues(workflowDataObj);
        if (!values) return;
        $('#waitingOn_' + headerId).text(values.waitingOn);
        $('#assignedTo_' + headerId).text(values.assignedTo);
        $('#extDays_' + headerId).text(values.extDays);
    }
    //edit action in list, popup opens
    $(document).on('click', '.js-edit', function () {
        var workflowHeaderID = $(this).data('wfhid');
        openWorkflowStatusPopup(workflowHeaderID);
    });

    //action in popup
    $(document).on("click", ".workflow-action-btn", function () {
        let btnId = (this.id);
        let workflowHeaderID = $(this).prev(".workflow-header-id").val();
        let url = $(this).data("url") + "?__csc=ACCOUNTS";
        let params = $(this).data("params");
        // Convert string params to object if needed
        params = typeof params === "string" ? JSON.parse(params) : params;
        $('#workflowStatusModal').modal('hide');
        Swal.fire({
            input: "textarea",
            inputPlaceholder: "Enter message…",
            inputAttributes: { style: "height:250px;" },
            showCancelButton: true,
            confirmButtonText: "Update",
            cancelButtonText: "Close",
            customClass: 'wide-swal no-header-swal',
            width: "900px",
            html: '<label class="swal-custom-label">Comment</label>'
        })
            .then(function (result) {
                if (!result || result.dismiss || result.escape) {
                    return Promise.reject("STOP");
                }
                mApp.blockPage({
                    type: "loader",
                    state: "brand",
                    message: "Please wait..."
                });

                params.msg = result.value;
                return $.ajax({
                    url: url,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(params)
                });
            })
            .then(function (response) {
                if (!response) {
                    Swal.fire("Error", "An error occurred.", "error");
                    return Promise.reject("STOP");
                }
                if (response.ResponseCode != 1) {
                    Swal.fire("Error", response.Message || "An error occurred.", "error");
                    return Promise.reject("STOP");
                }
                let newparams = { workflowTxnHeaderID: workflowHeaderID };

                // get the updated step instance
                return $.ajax({
                    url: "/api/Workflow/GetWorkflowInstanceStatus?workflowTxnHeaderID=" + workflowHeaderID,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(newparams)
                });
            })
            .then(function (apiData) {
                if (!apiData) {
                    Swal.fire("Error", response.Message || "An error occurred.", "error");
                    return Promise.reject("STOP");
                }
                var workflowDataObj = null;
                try {
                    workflowDataObj = apiData.AdditionalData1 ? JSON.parse(apiData.AdditionalData1) : null;
                } catch (e) {
                    workflowDataObj = null;
                }
                //also in main pagecontnt update the workflow it is waiting on
                // AdditionalData1 is JSON string in your API
                updateWorkflowListDom(workflowHeaderID, workflowDataObj);
                return $.ajax({
                    url: "/Workflows/RenderWorkflowView",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({
                        workflowHeaderID: workflowHeaderID,
                        workflowData: apiData.AdditionalData1
                    })
                });
            })
            .then(function (html) {
                if (!html)
                    Swal.fire("Error", "View not updated. Please refresh.", "error");
                // Replace workflow div content
                $("#workflow_" + workflowHeaderID).html(html);

            })
            .catch(function (xhr) {
                //Swal.fire("Error", xhr.responseText || "Workflow not updated", "error"); //handle each error seperately
            })
            .finally(function () {
                $('#workflowStatusModal').modal('show');
                mApp.unblockPage();
            });
    });
</script>

<script>
    //this is for the dashboard
    (function () {
        // avoid double-binding if partial is injected multiple times
        $(document).off('click.wfComment', '.wf-comment-more')
            .on('click.wfComment', '.wf-comment-more', function (e) {
                e.preventDefault();
                e.stopPropagation();

                // IMPORTANT: read attribute to preserve original spacing exactly
                var full = $(this).attr('data-comment') || '';

                Swal.fire({
                    title: 'Comment',
                    html: '<div style="text-align:left; white-space:pre-wrap;">' + $('<div/>').text(full).html() + '</div>',
                    confirmButtonText: 'Close'
                });
            });
    })();
</script>
<style>
.wf-comment-line {
    display: block;
}

.wf-comment-more {
    margin-left: 6px;
    vertical-align: middle;
}
</style>
