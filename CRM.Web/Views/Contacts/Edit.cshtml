@model ContactEditViewModel

<section class="panel">
    <h2>Edit Contact</h2>
    <form method="post" action="/Contacts/Edit">
        <input type="hidden" name="Id" value="@Model.Id" />
        <label>Name</label><br />
        <input name="Name" value="@Model.Name" required />
        <br /><br />
        <label>Email</label><br />
        <input name="EmailAddress" value="@Model.EmailAddress" required />
        <br /><br />
        <label>Associate Accounts</label><br />
        @foreach (var account in Model.Accounts)
        {
            var isChecked = Model.SelectedAccountIds.Contains(account.Id);
            <label>
                <input type="checkbox" name="SelectedAccountIds" value="@account.Id" checked="@isChecked" /> @account.Name
            </label>
            <br />
        }
        <br />
        <button type="submit">Save</button>
        <a href="/Contacts">Cancel</a>
    </form>
</section>
