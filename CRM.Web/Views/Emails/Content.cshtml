@model EmailContent

<section class="panel">
    <h2>Email Content</h2>
    <div class="actions">
        <a href="/Emails/Orphans">Back</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.HtmlBody))
{
    <div class="panel">
        @Html.Raw(Model.HtmlBody)
    </div>
}
else
{
    <pre>@Model.TextBody</pre>
}

@if (Model.Attachments.Count > 0)
{
    <section class="panel">
        <h3>Attachments</h3>
        <ul>
        @foreach (var attachment in Model.Attachments)
        {
            <li>@attachment.FileName (@attachment.SizeBytes bytes)</li>
        }
        </ul>
    </section>
}
