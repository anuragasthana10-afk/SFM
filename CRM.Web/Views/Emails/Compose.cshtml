@model ComposeEmailViewModel

<section class="panel">
    <h2>@Model.Mode Email</h2>
</section>

<form method="post" action="/Emails/Compose">
    <div class="panel">
        <label>From</label>
        <input type="text" name="From" value="@Model.From" />
    </div>
    <div class="panel">
        <label>To (comma separated)</label>
        <input type="text" name="To" value="@Model.To" />
    </div>
    <div class="panel">
        <label>Cc (comma separated)</label>
        <input type="text" name="Cc" value="@Model.Cc" />
    </div>
    <div class="panel">
        <label>Subject</label>
        <input type="text" name="Subject" value="@Model.Subject" />
    </div>
    <div class="panel">
        <label>Body</label>
        <textarea name="Body" rows="6">@Model.Body</textarea>
    </div>
    <input type="hidden" name="AccountGuid" value="@Model.AccountGuid" />
    <input type="hidden" name="ConversationId" value="@Model.ConversationId" />
    <input type="hidden" name="InReplyToMessageId" value="@Model.InReplyToMessageId" />
    <input type="hidden" name="Mode" value="@Model.Mode" />
    <button type="submit">Send</button>
</form>
