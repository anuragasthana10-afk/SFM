@model AccountListViewModel

<section class="panel">
    <h2>Accounts</h2>
    <a href="/Accounts/Create">Create Account</a>
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Account GUID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var account in Model.Accounts)
        {
            <tr>
                <td>@account.Id</td>
                <td>@account.Name</td>
                <td>@account.AccountGuid</td>
                <td>
                    <a href="/Accounts/Details/@account.Id">View Emails</a>
                    <a href="/Accounts/Edit/@account.Id">Edit</a>
                    <form method="post" action="/Accounts/Delete" style="display:inline">
                        <input type="hidden" name="id" value="@account.Id" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>

<section class="panel">
    <h3>Sync mailbox</h3>
    <form method="post" action="/Emails/Sync">
        <button type="submit">Sync last 7 days</button>
    </form>
</section>
